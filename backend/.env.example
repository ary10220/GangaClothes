# Copiar a .env y completar. NUNCA subir el .env real a GitHub.
# Neon (produccion). Si no se define, usa SQLite local para desarrollo.
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.neon.tech/gangaclothes?sslmode=require
JWT_SECRET=cambiar-por-una-clave-larga-y-secreta
CORS_ORIGINS=*
# Correo para recuperar contrasena.
# En local basta Gmail por SMTP (contrasena de aplicacion, no la normal):
SMTP_USUARIO=cuenta@gmail.com
SMTP_PASSWORD=contrasena-de-aplicacion
# En Render el plan gratuito bloquea SMTP: definir la clave de API de Brevo
# (el remitente, SMTP_USUARIO o CORREO_REMITENTE, debe estar verificado en Brevo).
BREVO_API_KEY=

# Dominio de la web, para que el catalogo devuelva las fotos con URL completa
# (lo necesita la app movil). Vacio = rutas relativas, que la web resuelve sola.
IMAGENES_BASE_URL=

# ============================ Pasarelas de pago (CU17) ============================
# Ninguna clave va al codigo: se leen de aqui y, en Render, del panel Environment.

# --- Stripe (tarjeta) -------------------------------------------------------
# dashboard.stripe.com -> interruptor "Test mode" encendido -> Developers -> API keys.
# Solo claves de prueba: una sk_live_ se rechaza al arrancar.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# --- QR del Banco de Credito de Bolivia (OpenBanking) -----------------------
# BCP_MODO=simulado  el QR se genera en el propio servidor; no se contacta al banco.
#          sandbox   https://sandbox.openbanking.bcp.com.bo con credenciales de prueba.
#          live      produccion.
# OJO: sandbox y live exigen TLS mutuo. Sin BCP_CERT_PFX el banco responde 403
# antes de leer el usuario y la contrasena.
BCP_MODO=simulado
BCP_USUARIO=
BCP_PASSWORD=
BCP_APP_USER_ID=
BCP_PUBLIC_TOKEN=
BCP_BUSINESS_CODE=
BCP_SERVICE_CODE=050
# Certificado de cliente para el TLS mutuo. Alcanza con UNA de las dos formas.
# Los archivos NO van al repositorio (.gitignore tapa certificados/ y *.crt/*.key).
#   1) el par PEM tal como lo entrega el banco (no necesita contrasena):
BCP_CERT_PEM=../certificados/bcp_cert.crt
BCP_CERT_KEY=../certificados/bcp_key.key
#   2) o el .pfx con su contrasena:
BCP_CERT_PFX=
BCP_CERT_PASSWORD=
# Minutos que vive un QR antes de vencer.
BCP_QR_MINUTOS=15
# Solo con BCP_MODO=simulado: a los cuantos segundos el simulador da el QR por
# pagado, como si alguien lo hubiera escaneado. Con 0 espera hasta vencer.
BCP_SIMULADOR_SEGUNDOS=8

# ============================ IA: asistente (CU28) ============================
# Clave gratuita de Google AI Studio: aistudio.google.com/apikey
# Sin esta clave el asistente igual responde, en modo "sin modelo": usa las
# mismas herramientas pero contesta con los datos en crudo, sin redactar.
# Se acepta tambien como GEMINI_API_KEY o GOOGLE_API_KEY.
GEMINI_API=
# Modelos a probar en orden, por si Google jubila el primero.
GEMINI_MODELOS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-flash-latest
# Cuantas veces puede el asistente pedir datos antes de tener que responder.
IA_MAX_PASOS=4
# Mensajes de la conversacion que se le recuerdan al modelo.
IA_MEMORIA_MENSAJES=12
